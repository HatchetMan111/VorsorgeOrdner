[Unit]
Description=Vorsorge-Ordner (FastAPI Web-App)
Documentation=https://github.com/HatchetMan111/VorsorgeOrdner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vorsorgeordner
Group=vorsorgeordner
# Hinweis: der Ein-Zeilen-Installer (install/vorsorgeordner.sh) klont dieses Repo nach
# /opt/vorsorgeordner, der App-Code selbst liegt darin unter opt/vorsorgeordner/ (siehe
# Repo-Struktur) -> effektiver Pfad ist /opt/vorsorgeordner/opt/vorsorgeordner/...
# Diese Datei dient nur als lesbare Referenz; die echte Unit wird vom Installer mit den
# korrekten, zur Laufzeit ermittelten Pfaden erzeugt.
WorkingDirectory=/opt/vorsorgeordner/opt/vorsorgeordner/app
ExecStart=/opt/vorsorgeordner/opt/vorsorgeordner/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
